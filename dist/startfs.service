# systemd user unit: runs the StartFS daemon and mounts the filesystem.
#
# Install:
#   install -Dm755 target/release/startfs ~/.local/bin/startfs
#   install -Dm644 dist/startfs.service ~/.config/systemd/user/startfs.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now startfs.service
#   loginctl enable-linger "$USER"     # start at boot, before you log in
#
# Needs /dev/fuse and the setuid fusermount3 helper (package: fuse3).
[Unit]
Description=StartFS daemon and mount
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# A crash leaves a dead mount (stat fails with "Transport endpoint is not connected"):
# clear it before starting. A live mount stats fine and is left alone, so a start that
# fails because an old daemon still runs cannot unmount that daemon's filesystem.
ExecStartPre=-/bin/sh -c 'stat "$1" >/dev/null 2>&1 || fusermount3 -uz "$1"' sh %h/StartFS
ExecStartPre=/usr/bin/mkdir -p %h/StartFS
ExecStart=%h/.local/bin/startfs daemon --mount %h/StartFS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
