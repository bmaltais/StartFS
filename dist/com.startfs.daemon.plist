<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: runs the StartFS daemon and mounts the filesystem at login/boot.
  UNTESTED: written without access to a Mac. Replace USERNAME with your user name.

  Install:
    install -m755 target/release/startfs /usr/local/bin/startfs
    cp dist/com.startfs.daemon.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.startfs.daemon.plist

  Requires FUSE-T (preferred, no kernel extension) or macFUSE. See dist/README.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.startfs.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/startfs</string>
    <string>daemon</string>
    <string>--mount</string>
    <string>/Users/USERNAME/StartFS</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardErrorPath</key>
  <string>/tmp/startfs.log</string>
</dict>
</plist>
